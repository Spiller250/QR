# VERIQ POC — copy to .env and adjust. All values below are DEMO values.
# Generate real secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORT=4000

# Demo-only operator credentials (NOT production authentication).
DEMO_ADMIN_EMAIL=operator@veriq.demo
DEMO_ADMIN_PASSWORD=veriq-demo-2026

# HMAC key used to derive the database lookup key for verification tokens.
TOKEN_HASH_SECRET=change-me-local-dev-only-secret

# HMAC key used to sign QR payloads (VQ1.<token>.<signature>). Must be different from
# TOKEN_HASH_SECRET. Changing it invalidates every printed label.
QR_SIGNING_SECRET=change-me-local-dev-only-qr-signing-secret

# Authorized client applications allowed to call POST /api/verify, as client-id:key pairs
# (comma-separated, keys at least 12 characters). Each app sends its key in X-App-Key.
APP_KEYS=web-scanner:dev-web-scanner-key,flutter-app:dev-flutter-app-key

# Key the built-in web scanner/simulator sends (exposed to the browser bundle by Vite —
# it identifies the client, it is NOT a secret). Must match the web-scanner entry above.
VITE_APP_KEY=dev-web-scanner-key

# SQLite database location (created and seeded automatically on first start).
DATABASE_PATH=./data/veriq.db

# Verification endpoint rate limit (requests per minute per IP).
VERIFY_RATE_LIMIT_PER_MINUTE=60

# ---- Copy Detection Pattern (physical label verification) ----
# Secret used to derive each label's random pattern (HMAC-SHA256(CDP_SECRET, token)).
# Changing it invalidates every printed label's pattern.
CDP_SECRET=change-me-local-dev-only-cdp-secret
# Internal Python analysis service (cdp-service/run-cdp.ps1). Keep it on localhost.
CDP_SERVICE_URL=http://127.0.0.1:8100
# Default decision threshold (0–1); can be overridden in Settings / Calibration.
CDP_THRESHOLD=0.6
# Pattern geometry: grid cells, cell size (mm) and printed QR size (mm).
CDP_GRID_SIZE=40
CDP_CELL_MM=0.15
LABEL_QR_MM=30
