<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: navy background with the VERIQ mark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/veriq_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/veriq_navy</item>
        <item name="android:statusBarColor">@color/veriq_navy</item>
        <item name="android:navigationBarColor">@color/veriq_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/veriq_navy</item>
    </style>
</resources>
